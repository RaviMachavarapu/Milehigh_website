---
// Styled placeholder marking a spot where a real image should go.
// Swap the whole <ImagePlaceholder .../> for an <img>/<picture> when ready.
interface Props {
  /** describe the intended image + a recommended pixel size */
  label?: string;
  /** Tailwind aspect-ratio utility, e.g. 'aspect-video', 'aspect-square', 'aspect-[4/3]', 'aspect-[21/9]' */
  ratio?: string;
  /** light = on light surfaces; dark = on navy/forest surfaces */
  tone?: 'light' | 'dark';
  class?: string;
}
const {
  label = 'Image placeholder',
  ratio = 'aspect-video',
  tone = 'light',
  class: extra = '',
} = Astro.props;
const toneCls =
  tone === 'dark'
    ? 'border-white/25 bg-white/5 text-white/55'
    : 'border-navy/20 bg-navy/[0.035] text-navy/45';
---

<div
  class:list={[
    'flex w-full flex-col items-center justify-center gap-2.5 rounded-2xl border-2 border-dashed text-center',
    ratio,
    toneCls,
    extra,
  ]}
  role="img"
  aria-label={label}
>
  <svg
    width="30"
    height="30"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="3" width="18" height="18" rx="2" />
    <circle cx="9" cy="9" r="2" />
    <path d="m21 15-3.5-3.5a2 2 0 0 0-2.8 0L6 20" />
  </svg>
  <span class="max-w-[80%] text-xs font-medium leading-snug">{label}</span>
</div>
