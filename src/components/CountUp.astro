---
// Animated count-up number. Pass the display string (e.g. "42%", "4.2×",
// "−18h", "<5 min"). The leading non-digit prefix and the trailing non-digit
// suffix are preserved; the numeric part (integer or decimal) animates from 0
// when scrolled into view. Values without an animatable number (e.g. "Zero",
// "24/7") render unchanged.
interface Props {
  value: string;
  class?: string;
}
const { value, class: className } = Astro.props;

const m = value.match(/^(\D*)(\d+(?:\.\d+)?)(\D*)$/);
const parsed = m
  ? {
      prefix: m[1],
      target: m[2],
      suffix: m[3],
      decimals: m[2].includes('.') ? m[2].split('.')[1].length : 0,
    }
  : null;
const zero = parsed ? `${parsed.prefix}${(0).toFixed(parsed.decimals)}${parsed.suffix}` : '';
---

{
  parsed ? (
    <span
      class:list={['stat-count tabular-nums', className]}
      data-target={parsed.target}
      data-prefix={parsed.prefix}
      data-suffix={parsed.suffix}
      data-decimals={parsed.decimals}
    >
      {zero}
    </span>
  ) : (
    <span class:list={className}>{value}</span>
  )
}

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fmt = (el: HTMLElement, n: number) => {
    const d = Number(el.dataset.decimals ?? '0');
    return `${el.dataset.prefix ?? ''}${n.toFixed(d)}${el.dataset.suffix ?? ''}`;
  };

  const run = (el: HTMLElement) => {
    const target = Number(el.dataset.target ?? '0');
    if (reduce) {
      el.textContent = fmt(el, target);
      return;
    }
    const duration = 1600;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      // easeOutExpo — fast start, smooth deceleration to the final value
      const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
      el.textContent = fmt(el, target * eased);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const io = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          run(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.4 },
  );

  document.querySelectorAll<HTMLElement>('.stat-count').forEach((el) => io.observe(el));
</script>
