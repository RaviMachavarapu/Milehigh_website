---
// Hero band with the page content centered on a deep navy background.
// - No images  -> a clean navy gradient (default).
// - One image  -> static photographic background.
// - Many images -> a horizontal sliding carousel behind the fixed content.
import BackLink from './BackLink.astro';

interface Props {
  /** Optional background photo(s). Omit for a plain navy gradient hero. */
  images?: string[];
  /** ms each slide is shown before sliding to the next (multi-image only) */
  interval?: number;
  /** extra classes on the <section> */
  class?: string;
  /** when set, renders a "Back" link pinned to the hero's top-left */
  backHref?: string;
  backLabel?: string;
  /** use the black-left / blue-right split background (no images) */
  splitBg?: boolean;
  /** text-left / image-right layout with a black scrim that blends into the photo */
  sideText?: boolean;
}
const {
  images = [],
  interval = 5500,
  class: className = '',
  backHref,
  backLabel = 'Back',
  splitBg = false,
  sideText = false,
} = Astro.props;
const hasImages = images.length > 0;
const multi = images.length > 1;
// Clone the first image at the end so the slide from last -> first is seamless.
const trackSlides = multi ? [...images, images[0]] : images;
---

<section
  class:list={[
    'hero-media hero-navy-bg relative isolate flex min-h-[560px] items-center overflow-hidden text-white md:min-h-[600px] lg:min-h-[640px]',
    className,
  ]}
  style={`--hero-delay:${interval}ms`}
  data-hero-slider={multi ? 'true' : null}
>
  {
    hasImages ? (
      <div class="absolute inset-0 -z-10 overflow-hidden">
        {/* Sliding image track (behind overlay + content) */}
        <div class="hero-track flex h-full w-full" data-track>
          {trackSlides.map((src, i) => (
            <div class="relative h-full w-full shrink-0 basis-full">
              <img
                src={src}
                alt=""
                aria-hidden="true"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class:list={[
                  'h-full w-full object-cover',
                  sideText ? 'object-right' : 'object-center',
                ]}
              />
            </div>
          ))}
        </div>
        {sideText ? (
          <>
            {/* Black scrim on the LEFT for the text, fading into the photo on the right */}
            <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent md:via-black/70" />
            {/* Top 40% + bottom 20% black blend so the photo melts into the page edges */}
            <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,0,0,0.9)_0%,rgba(0,0,0,0)_40%,rgba(0,0,0,0)_80%,rgba(0,0,0,0.9)_100%)]" />
          </>
        ) : (
          <>
            {/* Transparency overlay so the centered text reads cleanly on any photo */}
            <div class="absolute inset-0 bg-gradient-to-b from-navy/75 via-navy/55 to-navy/80" />
            <div class="absolute inset-0 bg-navy/25" />
          </>
        )}
      </div>
    ) : splitBg ? (
      /* Black-left / blue-right split background (homepage hero) */
      <div class="hero-split-bg absolute inset-0 -z-10" />
    ) : (
      /* Plain blue hero: subtle gradient + soft glow for depth (no images) */
      <div class="hero-navy-bg absolute inset-0 -z-10">
        <div class="absolute -top-1/3 left-1/2 h-[120%] w-[80%] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(232,168,124,0.10),transparent)]" />
      </div>
    )
  }

  {
    backHref && (
      <div class="container-max absolute inset-x-0 top-0 z-20 pt-8 md:pt-10">
        <BackLink href={backHref} label={backLabel} variant="light" />
      </div>
    )
  }

  <div class="container-max relative w-full py-12 md:py-16">
    <slot />
  </div>

  {
    hasImages && multi && (
      <div class="container-max absolute inset-x-0 bottom-8 z-10">
        <div class="flex justify-center gap-2.5" role="tablist" aria-label="Hero slides">
          {images.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`Show slide ${i + 1}`}
              class:list={[
                'hero-dot h-2 rounded-full transition-all duration-300',
                i === 0 ? 'w-8 bg-terracotta' : 'w-2 bg-white/35 hover:bg-white/60',
              ]}
            />
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .hero-track {
    transition: transform 700ms ease-out;
  }
  /* Reduced motion: switch instantly instead of sliding. */
  @media (prefers-reduced-motion: reduce) {
    .hero-track {
      transition: none;
    }
  }
</style>

<script>
  function initHeroSlider(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.hero-dot'));
    const real = dots.length; // number of real (non-clone) slides
    if (!track || real < 2) return;

    const delay = parseInt(getComputedStyle(root).getPropertyValue('--hero-delay')) || 5500;
    const RESET_DELAY = 760; // a touch longer than the CSS transition
    let current = 0;
    let timer: number | undefined;

    function setDots(active: number) {
      dots.forEach((d, i) => {
        const on = i === active;
        d.classList.toggle('w-8', on);
        d.classList.toggle('bg-terracotta', on);
        d.classList.toggle('w-2', !on);
        d.classList.toggle('bg-white/35', !on);
      });
    }

    function move(i: number, animate: boolean) {
      track!.style.transition = animate ? '' : 'none';
      track!.style.transform = `translateX(-${i * 100}%)`;
    }

    function advance() {
      current += 1;
      move(current, true);
      setDots(current % real);
      // Landed on the cloned first slide -> snap back to the real first.
      if (current === real) {
        window.setTimeout(() => {
          move(0, false);
          current = 0;
          void track!.offsetWidth; // commit the no-transition reset
        }, RESET_DELAY);
      }
    }

    function start() {
      stop();
      timer = window.setInterval(advance, delay);
    }
    function stop() {
      if (timer) window.clearInterval(timer);
    }

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        current = i;
        move(current, true);
        setDots(i);
        start();
      })
    );
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    setDots(0);
    start();
  }

  document
    .querySelectorAll<HTMLElement>('[data-hero-slider]')
    .forEach((el) => initHeroSlider(el));
</script>
