---
// Accessible FAQ accordion (native <details>, zero JS). AEO-friendly:
// pair with a FAQPage JSON-LD built from the same `items`.
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
  heading?: string;
}
const { items, heading = 'Questions, answered' } = Astro.props;
---

<section class="section bg-warm" aria-labelledby="faq-heading">
  <div class="container-max max-w-3xl">
    <h2 id="faq-heading" class="text-3xl md:text-4xl">{heading}</h2>
    <div class="faq-list mt-8 divide-y divide-navy/10 border-y border-navy/10">
      {
        items.map((item, index) => (
          <details class="faq-item group py-5" style={`--i:${index}`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-navy">
              <span>{item.q}</span>
              <svg
                class="shrink-0 transition-transform group-open:rotate-45"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Staggered reveal: each question eases up + fades in, one after another, when
     the section scrolls into view. The hidden state is only applied once JS adds
     `.faq-animate`, so without JS every answer stays fully visible (SEO/AEO-safe). */
  .faq-animate .faq-item {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  .faq-animate.is-visible .faq-item {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-animate .faq-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Reveal each FAQ list's items in sequence the first time it enters the viewport.
  document.querySelectorAll<HTMLElement>('.faq-list').forEach((list) => {
    list.classList.add('faq-animate');
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    io.observe(list);
  });
</script>
