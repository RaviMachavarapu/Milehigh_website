---
// Human-in-the-Loop trust mark — terracotta checkmark in a person silhouette.
// Non-optional on service cards per brand spec.
interface Props {
  label?: string;
  class?: string;
}
const { label = 'Human-reviewed', class: extra = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full bg-terracotta/15 px-3 py-1 text-xs font-semibold text-navy',
    extra,
  ]}
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#d8915f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
  {label}
</span>
