---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'dark' | 'navy';
  size?: 'md' | 'sm';
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', external = false, class: extra = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium transition-colors';
const sizes = {
  md: 'px-6 py-3',
  sm: 'px-3 py-2',
};
const variants = {
  primary: 'bg-terracotta text-white hover:bg-terracotta-600',
  secondary: 'border border-navy/30 text-navy hover:border-navy hover:bg-navy/5',
  dark: 'border border-white/40 text-white hover:bg-white/10',
  navy: 'bg-navy text-white hover:bg-navy/90',
};
const rel = external ? 'noopener' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} class:list={[base, sizes[size], variants[variant], extra]} target={target} rel={rel}>
  <slot />
</a>
