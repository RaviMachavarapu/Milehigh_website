---
import { site, navLinks } from '../data/site';

// When `solid` is true the nav starts opaque (used on pages without a dark hero).
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
---

<header
  id="site-nav"
  data-solid="true"
  class="sticky inset-x-0 top-0 z-50 bg-navy shadow-sm"
>
  <nav class="container-max flex h-16 items-center justify-between gap-4 md:h-20" aria-label="Primary">
    <a
      href="/"
      class="flex items-center rounded-lg bg-terracotta px-3.5 py-2 transition-colors hover:bg-terracotta-600 md:px-4 md:py-2.5"
      aria-label="Mile High AI Labs, home"
    >
      <img
        src="/images/logo-mhal.png"
        alt="Mile High AI Labs"
        width="560"
        height="150"
        class="logo-mhal h-9 w-auto md:h-11"
      />
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-white transition-colors hover:text-terracotta-300"
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.contact}
        class="text-sm font-medium text-white/80 transition-colors hover:text-white"
      >
        Contact
      </a>
      <a
        href={site.booking}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-2 rounded-lg border border-white/40 px-4 py-2 text-sm font-medium text-white transition-colors hover:border-white hover:bg-white/10"
      >
        Book a Free Call
        <svg
          class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      class="text-white lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-white/10 bg-navy lg:hidden">
    <div class="container-max flex flex-col gap-1 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-2 py-2.5 text-base font-medium text-white hover:bg-white/5"
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.contact}
        class="rounded-md px-2 py-2.5 text-base font-medium text-white/85 hover:bg-white/5"
      >
        Contact
      </a>
      <a
        href={site.booking}
        target="_blank"
        rel="noopener"
        class="mt-2 rounded-lg bg-terracotta px-4 py-2.5 text-center text-base font-medium text-white"
      >
        Book a Free Call
      </a>
    </div>
  </div>
</header>

<style>
  /* Flat, dark violet wordmark. No glow at all — completely matte/crisp. */
  .logo-mhal {
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-mhal { transition: none; }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const startsSolid = nav?.dataset.solid === 'true';

  // Transparent hero nav turns solid once the user scrolls past the fold.
  if (nav && !startsSolid) {
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      nav.classList.toggle('bg-navy/95', scrolled);
      nav.classList.toggle('backdrop-blur-md', scrolled);
      nav.classList.toggle('shadow-sm', scrolled);
      nav.classList.toggle('bg-transparent', !scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
