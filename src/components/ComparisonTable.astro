---
// Comparison table. The last column (Mile High AI Labs) is highlighted.
// `rows` cells: string | true (check) | false (dash).
type Cell = string | boolean;
interface Props {
  columns: string[]; // e.g. ['Capability', 'Traditional', 'In-House Team', 'Mile High AI Labs']
  rows: { label: string; values: Cell[] }[];
}
const { columns, rows } = Astro.props;
const lastIdx = columns.length - 1;
---

<div class="overflow-x-auto">
  <table class="mx-auto border-collapse">
    <thead>
      <tr>
        {
          columns.map((col, i) => (
            <th
              class:list={[
                'border-b border-navy/10 px-5 py-4 text-sm font-semibold',
                i === 0 ? 'min-w-[200px] max-w-[260px] text-left' : 'min-w-[150px] text-center',
                i === lastIdx ? 'rounded-t-xl bg-terracotta-600 text-white' : 'text-ink-soft',
              ]}
            >
              {col}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, ri) => (
          <tr class="align-middle">
            <th scope="row" class="min-w-[200px] max-w-[260px] border-b border-navy/10 px-5 py-4 text-left text-sm font-medium text-navy">
              {row.label}
            </th>
            {row.values.map((val, ci) => {
              const highlight = ci + 1 === lastIdx;
              return (
                <td
                  class:list={[
                    'border-b border-navy/10 px-5 py-4 text-center text-sm',
                    highlight ? 'bg-terracotta/10 text-navy' : 'text-ink-soft',
                    highlight && ri === rows.length - 1 ? 'rounded-b-xl' : '',
                  ]}
                >
                  {typeof val === 'boolean' ? (
                    val ? (
                      <span
                        class:list={[
                          'inline-flex h-7 w-7 items-center justify-center rounded-full',
                          highlight ? 'bg-emerald-100 text-emerald-700' : 'bg-forest/10 text-forest',
                        ]}
                        aria-label="Yes"
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                    ) : (
                      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-navy/5 text-ink-soft/60" aria-label="No">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                      </span>
                    )
                  ) : (
                    val
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
