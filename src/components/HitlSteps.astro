---
// Condensed 3-step process for pillar pages.
// Middle step (human review) is always terracotta per brand spec.
const steps = [
  { n: '01', title: 'Discovery', desc: 'We look at how you work today and find the exact thing costing you time or money.' },
  { n: '02', title: 'Human Review', desc: 'We build it, then a real person checks the work before it ever touches your business.', hitl: true },
  { n: '03', title: 'Go Live', desc: 'We launch, keep a close eye on the first 48 hours, and look after it from there.' },
];
interface Props {
  heading?: string;
}
const { heading = 'Why a real person checks everything' } = Astro.props;
---

<section class="section bg-white">
  <div class="container-max">
    <h2 class="mx-auto max-w-2xl text-center text-3xl md:text-4xl">{heading}</h2>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        steps.map((s) => (
          <div
            class:list={[
              'rounded-2xl border p-8',
              s.hitl ? 'border-terracotta bg-terracotta/10' : 'border-navy/10 bg-warm',
            ]}
          >
            <div class="flex items-center justify-between">
              <span class:list={['font-serif text-2xl', s.hitl ? 'text-terracotta-600' : 'text-navy/40']}>{s.n}</span>
              {s.hitl && (
                <span class="rounded-full bg-terracotta px-2.5 py-0.5 text-xs font-semibold text-white">Human check</span>
              )}
            </div>
            <h3 class="mt-4 text-xl text-navy">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
