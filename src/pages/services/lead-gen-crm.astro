---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import HitlSteps from '../../components/HitlSteps.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import FAQ from '../../components/FAQ.astro';
import CountUp from '../../components/CountUp.astro';
import { site } from '../../data/site';
import { service, faqPage, breadcrumb } from '../../lib/jsonld';

const capabilities = [
  { h: 'One place for every enquiry', p: 'Website, social, calls, and texts all land in one tidy list, with duplicates removed.' },
  { h: 'Friendly follow-ups', p: 'We stay in touch at the right moment with messages that feel personal, hands-free for your team.' },
  { h: "Know who's ready to buy", p: "We track who's opening, clicking, and replying, then show you who's worth a call each day." },
  { h: 'Set up around how you sell', p: 'Built around the real steps your business follows, not a generic template, with team training included.' },
  { h: 'Know your lead before you call', p: 'Each contact comes with their company, role, and interests, so you call prepared.' },
  { h: 'Nothing slips through', p: 'Clear timelines and automatic reminders make sure no deal gets forgotten.' },
];

const metrics = [
  { value: '42%', label: 'More good leads ready to buy' },
  { value: '−18h', label: 'Hours saved every week' },
  { value: 'Zero', label: 'Leads left without a reply' },
  { value: '12.5×', label: 'Faster from first hello to sale' },
];

const faqs = [
  {
    q: 'How fast will leads actually get a response?',
    a: 'Within seconds. Businesses that reply to a new enquiry within five minutes are far more likely to win the customer, yet the average business takes more than two days. We close that gap completely with instant, personal replies, day or night.',
  },
  {
    q: 'Do I have to replace my current CRM?',
    a: 'Not necessarily. We build around the way you already sell and the tools your team likes using, and we only suggest a change when your current setup is actively costing you customers.',
  },
  {
    q: 'Is the outreach automated or written by a person?',
    a: 'Both. The AI writes and personalises the messages, and someone on our team checks the wording and the thinking behind it before anything reaches a real person. That human check is built into the way we work.',
  },
  {
    q: 'How long until I see results?',
    a: 'Most clients see more leads moving faster within the first 30 days. The setup and the first round of checks are usually done within the first two weeks.',
  },
];

const jsonLd = [
  service({
    name: 'Lead Gen & CRM',
    description:
      'Managed AI lead generation and CRM for small and medium businesses: catching enquiries, spotting who is ready to buy, following up, and keeping everything organised, with a real person checking the work.',
    path: '/services/lead-gen-crm',
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Lead Gen & CRM', path: '/services/lead-gen-crm' },
  ]),
];
---

<BaseLayout
  title="Lead Gen & CRM for Small and Medium Businesses"
  description="Lead generation for small and medium businesses. We catch every enquiry, spot who is ready to buy, and follow up for you, with a real person checking the work. No more good leads slipping away."
  path="/services/lead-gen-crm"
  keywords="AI lead generation, CRM setup, lead scoring, lead nurturing, contact enrichment, sales pipeline automation, SMB lead gen"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <HeroMedia images={['/images/heroes/hero-leadgen.jpg']} sideText>
    <div class="max-w-xl text-left">
      <p class="eyebrow text-xl text-terracotta-300 md:text-2xl">Lead Gen & CRM</p>
      <h1 class="mt-5 font-serif text-4xl font-extrabold leading-[1.1] md:text-5xl">
        Never lose a good <span class="accent-em text-white">lead</span> again.
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white">
        We capture every enquiry, score the leads worth your time, and follow up automatically,
        so good customers never slip through the cracks.
      </p>
      <div class="mt-9 flex flex-wrap justify-start gap-4">
        <Button href={site.booking} external>Get started →</Button>
        <Button href={site.contact} variant="dark">Talk to the team</Button>
      </div>
    </div>
  </HeroMedia>

  <!-- CAPABILITIES -->
  <section class="section bg-warm">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl md:text-4xl">Everything working on your leads</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Built around your industry, your customers, and the way you sell. No two setups are
          ever the same.
        </p>
      </div>
      <div class="mt-14 grid items-stretch gap-8 lg:grid-cols-[1fr_2fr]">
        <img
          src="/images/content/leadgen-crm.jpg"
          alt="A lead and CRM dashboard with contacts and follow-up activity"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          class="h-full min-h-[280px] w-full rounded-2xl border border-navy/10 object-cover shadow-lg shadow-navy/5"
        />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            capabilities.map((c) => (
              <div class="card-lift flex h-full flex-col p-6">
                <h3 class="text-lg leading-snug text-navy">{c.h}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{c.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section bg-white">
    <div class="container-max">
      <h2 class="mx-auto max-w-2xl text-center text-3xl md:text-4xl">Not all follow-up is the same.</h2>
      <div class="mt-12">
        <ComparisonTable
          columns={['What you get', 'Traditional', 'In-House Team', 'Mile High AI Labs']}
          rows={[
            { label: 'Knows who the lead is', values: [false, true, true] },
            { label: 'Finds new leads as they appear', values: [false, false, true] },
            { label: 'Personal messages to everyone', values: [false, true, true] },
            { label: 'Works with your CRM', values: [true, true, true] },
            { label: 'A real person checks every message', values: [false, false, true] },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- DAY 30 PROMISE -->
  <section class="relative isolate overflow-hidden bg-navy py-20 text-white lg:py-28">
    <div class="pointer-events-none absolute -right-28 -top-28 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.22),transparent)]"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-28 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.16),transparent)]"></div>
    <div class="container-max relative">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-serif text-3xl font-bold text-terracotta-300 md:text-4xl">The results we promise</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          What your leads look like with Mile High AI Labs.
        </p>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          metrics.map((m) => (
            <div class="rounded-2xl bg-white p-7 text-center shadow-lg shadow-black/10">
              <p class="font-serif text-4xl font-bold text-navy"><CountUp value={m.value} /></p>
              <p class="mt-2 text-sm text-ink-soft">{m.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <HitlSteps
    steps={[
      { n: '01', title: 'Every enquiry captured & scored', desc: 'We tune the AI to your business so each new enquiry is logged in your CRM and scored, surfacing the leads actually worth your time.' },
      { n: '02', title: 'Human Review', desc: 'Before any reply or follow-up reaches a prospect, a real person checks the lead was read right and the message fits, so nothing tone-deaf goes out.', hitl: true },
      { n: '03', title: 'Followed up, never dropped', desc: 'Once approved, every qualified lead gets a timely, on-brand follow-up, so good customers never slip through the cracks.' },
    ]}
  />

  <FAQ items={faqs} />

  <!-- CLOSING TESTIMONIAL + CTA -->
  <section class="section bg-warm pt-0">
    <div class="container-max">
      <figure class="mx-auto max-w-2xl rounded-3xl border border-navy/10 bg-white p-8 shadow-lg shadow-navy/5 md:p-10">
        <div class="flex items-center justify-between">
          <svg class="h-9 w-9 text-terracotta" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <div class="flex gap-1 text-amber" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
            ))}
          </div>
        </div>
        <blockquote class="mt-6 text-xl font-medium leading-relaxed text-navy md:text-2xl">
          Mile High AI Labs transformed our lead flow in 3 weeks. Good prospects no longer slip
          away, and the team finally trusts what's in the pipeline.
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-4 border-t border-navy/[0.08] pt-6">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy text-white" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3" /><path d="M9 9h.01M9 13h.01M9 17h.01" /></svg>
          </span>
          <span class="leading-tight">
            <span class="block font-semibold text-navy">Founder</span>
            <span class="text-sm text-ink-soft">Professional services firm</span>
          </span>
        </figcaption>
      </figure>

      <div class="mx-auto mt-10 max-w-2xl text-center">
        <p class="text-lg font-semibold text-navy">Ready to see results like these?</p>
        <div class="mt-5 flex flex-wrap justify-center gap-4">
          <Button href={site.booking} external size="sm">Book a Free Call</Button>
          <Button href={site.contact} variant="secondary" size="sm">Talk to our team</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
