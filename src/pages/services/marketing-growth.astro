---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import HitlSteps from '../../components/HitlSteps.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQ from '../../components/FAQ.astro';
import CountUp from '../../components/CountUp.astro';
import { site } from '../../data/site';
import { service, faqPage, breadcrumb } from '../../lib/jsonld';

const engine = [
  { n: '01', title: 'Planning', desc: 'We plan what to post around your goals, your audience, and the time of year.' },
  { n: '02', title: 'Creation', desc: 'The AI writes posts, emails, and ads in your brand voice, ready to go.' },
  { n: '03', title: 'Review', desc: 'A real person checks every piece before it goes out, so the tone, the facts, and your brand stay right.', hitl: true },
  { n: '04', title: 'Results', desc: 'We show you how each post did, then make the next batch even better.' },
];

const capabilities = [
  { h: 'Social posts done for you', p: 'On-brand posts for Facebook, Instagram, and LinkedIn, shared regularly without your team writing a word.' },
  { h: 'Campaigns for every launch', p: 'Every new launch or promotion gets a full set of posts, words, and images across your channels, handled for you.' },
  { h: 'LinkedIn & Instagram', p: 'Helpful, expert posts on LinkedIn and eye-catching stories on Instagram, two of the best places for growing businesses to be seen.' },
  { h: 'Email newsletters', p: 'Regular, genuinely useful newsletters sent at the right time, with simple reports on who opened and clicked.' },
  { h: 'Ready-to-run ads', p: 'Several versions of each ad so you can see what works best across Facebook, Google, and LinkedIn, sized correctly and ready to go.' },
  { h: 'A real person checks it, always', p: 'Our team looks over every piece before it goes out, so your brand always looks its best.' },
];

const metrics = [
  { value: '4.2×', label: 'Average return on what you spend on content' },
  { value: '100%', label: 'Posts checked by a real person before going out' },
  { value: '3×', label: 'More leads than old-school cold outreach' },
  { value: '62%', label: 'Cheaper than old-school marketing' },
];

const faqs = [
  {
    q: 'Will the content actually sound like my business?',
    a: 'Yes. We start from your voice, your audience, and your brand, and a real person checks every piece before it goes out. Nothing gets posted that reads generic or off-brand.',
  },
  {
    q: 'How is this different from a marketing agency?',
    a: 'This kind of marketing brings in roughly three times more leads at about 62% of the cost of old-school cold outreach. We run the whole thing for you, from planning to writing to checking to posting, for far less than an agency or a full-time hire.',
  },
  {
    q: 'Do you post it for me, or just write it?',
    a: 'Both. We write it, check it, and post it for you across your channels on a steady schedule, so you can stay focused on running the business.',
  },
  {
    q: 'Can I take this without the other services?',
    a: 'Yes. Marketing & Growth works on its own, or alongside Lead Gen & CRM and AI Solutions & Workflows for a fuller setup.',
  },
];

const jsonLd = [
  service({
    name: 'Marketing & Growth',
    description:
      'Managed AI marketing for small and medium businesses: social posts, emails, and ads written and checked by real people, then posted for you automatically.',
    path: '/services/marketing-growth',
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Marketing & Growth', path: '/services/marketing-growth' },
  ]),
];
---

<BaseLayout
  title="Marketing & Growth for Small and Medium Businesses"
  description="Marketing for small and medium businesses. We write, check, and post your social, email, and ads in your own voice, so you can focus on running the business."
  path="/services/marketing-growth"
  keywords="AI content marketing, social media automation, email marketing AI, ad creative generation, managed content engine, SMB marketing"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <HeroMedia images={['/images/heroes/hero-marketing.jpg']} sideText>
    <div class="max-w-xl text-left">
      <p class="eyebrow text-xl text-terracotta-300 md:text-2xl">Marketing & Growth</p>
      <h1 class="mt-5 font-serif text-4xl font-extrabold leading-[1.1] md:text-5xl">
        Marketing that sounds <span class="accent-em text-white">just like you</span>.
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white">
        We write, review, and publish on-brand content across the channels your customers
        actually use.
      </p>
      <div class="mt-9 flex flex-wrap justify-start gap-4">
        <Button href={site.booking} external>Get started →</Button>
        <Button href={site.contact} variant="dark">Talk to the team</Button>
      </div>
    </div>
  </HeroMedia>

  <!-- CAPABILITIES -->
  <section class="section bg-warm">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl md:text-4xl">A marketing department, without the headcount</h2>
      </div>
      <div class="mt-14 grid items-stretch gap-8 lg:grid-cols-12">
        <div class="lg:col-span-5 xl:col-span-4">
          <img
            src="/images/content/marketing-content.jpg"
            alt="A workspace with devices and tools used to plan and publish marketing content"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="h-64 w-full rounded-2xl border border-navy/10 object-cover shadow-lg shadow-navy/5 sm:h-80 lg:h-full"
          />
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3 xl:col-span-8">
          {
            capabilities.map((c) => (
              <div class="card-lift flex flex-col p-6">
                <h3 class="text-lg text-navy">{c.h}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{c.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section bg-white">
    <div class="container-max">
      <h2 class="mx-auto max-w-2xl text-center text-3xl md:text-4xl">Traditional agency vs. Mile High AI Labs</h2>
      <div class="mt-12">
        <ComparisonTable
          columns={['What you get', 'Traditional agency', 'Mile High AI Labs']}
          rows={[
            { label: 'How often you post', values: ['Now and then', 'Every week'] },
            { label: 'What it costs', values: ['Retainer plus per-item', 'One simple managed fee'] },
            { label: 'A real person checks every piece', values: [false, true] },
            { label: 'Posts across all your channels', values: ['Add-on', true] },
            { label: 'How fast a launch goes out', values: ['Days to weeks', 'Same week'] },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- DAY 30 OUTCOMES -->
  <section class="relative isolate overflow-hidden bg-navy py-20 text-white lg:py-28">
    <div class="pointer-events-none absolute -right-28 -top-28 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.22),transparent)]"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-28 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.16),transparent)]"></div>
    <div class="container-max relative">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-serif text-3xl font-bold text-terracotta-300 md:text-4xl">The outcomes we deliver</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          What real results look like with Mile High AI Labs Marketing & Growth.
        </p>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          metrics.map((m) => (
            <div class="rounded-2xl bg-white p-7 text-center shadow-lg shadow-black/10">
              <p class="font-serif text-4xl font-bold text-navy"><CountUp value={m.value} /></p>
              <p class="mt-2 text-sm text-ink-soft">{m.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- THE MANAGED CONTENT ENGINE (4-step) -->
  <section class="section bg-white">
    <div class="container-max">
      <h2 class="mx-auto max-w-2xl text-center text-3xl md:text-4xl">How your marketing gets made</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          engine.map((s) => (
            <div
              class:list={[
                'rounded-2xl border p-7',
                s.hitl ? 'border-terracotta bg-terracotta/10' : 'border-navy/10 bg-warm',
              ]}
            >
              <div class="flex items-center justify-between">
                <span class:list={['font-serif text-2xl', s.hitl ? 'text-terracotta-600' : 'text-navy/40']}>{s.n}</span>
                {s.hitl && <span class="rounded-full bg-terracotta px-2.5 py-0.5 text-xs font-semibold text-white">Human check</span>}
              </div>
              <h3 class="mt-4 text-xl text-navy">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <!-- CLOSING TESTIMONIAL + CTA -->
  <section class="section bg-warm pt-0">
    <div class="container-max">
      <figure class="mx-auto max-w-2xl rounded-3xl border border-navy/10 bg-white p-8 shadow-lg shadow-navy/5 md:p-10">
        <div class="flex items-center justify-between">
          <svg class="h-9 w-9 text-terracotta" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <div class="flex gap-1 text-amber" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
            ))}
          </div>
        </div>
        <blockquote class="mt-6 text-xl font-medium leading-relaxed text-navy md:text-2xl">
          I'm not a marketer and I don't have the time to become one. They handle the posts and
          the emails, someone on their side actually reads it before it goes out, and it still
          sounds like us. That last part is what sold me.
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-4 border-t border-navy/[0.08] pt-6">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy text-white" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3" /><path d="M9 9h.01M9 13h.01M9 17h.01" /></svg>
          </span>
          <span class="leading-tight">
            <span class="block font-semibold text-navy">Owner</span>
            <span class="text-sm text-ink-soft">Multi-location services brand</span>
          </span>
        </figcaption>
      </figure>

      <div class="mx-auto mt-10 max-w-2xl text-center">
        <p class="text-lg font-semibold text-navy">Ready to see results like these?</p>
        <div class="mt-5 flex flex-wrap justify-center gap-4">
          <Button href={site.booking} external size="sm">Book a Free Call</Button>
          <Button href={site.contact} variant="secondary" size="sm">Talk to our team</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
