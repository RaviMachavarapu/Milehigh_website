---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import HitlSteps from '../../components/HitlSteps.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQ from '../../components/FAQ.astro';
import CountUp from '../../components/CountUp.astro';
import { site } from '../../data/site';
import { service, faqPage, breadcrumb } from '../../lib/jsonld';

const capabilities = [
  { h: 'Instant replies to every enquiry', p: 'Every new message, from anywhere, gets a personal reply within seconds, and it hands over to a real person the moment someone is ready to buy.' },
  { h: 'The busywork, handled', p: 'Approvals, reminders, updates, and passing work between people all happen on their own, with nothing typed twice and no steps missed.' },
  { h: 'Follow-ups that never forget', p: 'Gentle reminders by email, text, and call that keep going until someone replies, then politely pause.' },
  { h: 'Booking made easy', p: 'It finds a time, confirms it, sends reminders, and reschedules when needed, so there are fewer no-shows and far less back-and-forth.' },
  { h: 'Keep work moving', p: 'Simple step-by-step checklists, paperwork sent to the right person, and clear views for your team so nothing stalls.' },
  { h: 'Your data can stay with you', p: 'In fields with strict privacy rules, everything can run on your own computers, so your data never leaves the building.' },
];

const metrics = [
  { value: '21×', label: 'More likely to win a customer when you reply in 5 minutes' },
  { value: '<5 min', label: 'Typical time to first reply' },
  { value: '24/7', label: 'Cover, with no gaps on nights or weekends' },
  { value: '100%', label: 'Checked by a real person before going live' },
];

const faqs = [
  {
    q: 'What can actually be handled for me?',
    a: 'Anything repetitive that follows clear rules: replying to enquiries, following up, booking appointments, approvals, typing in data, and passing work between people. We start by looking at where your hours go, then take the most time-consuming jobs off your plate first.',
  },
  {
    q: 'Why does response time matter so much?',
    a: 'Businesses that reply to a new enquiry within five minutes are far more likely to win the customer, but the average business takes more than two days. This makes you the business that always replies first.',
  },
  {
    q: 'What if the AI makes a mistake?',
    a: 'That is exactly what our review step prevents. Nothing goes live without a real person checking it first, and we keep a close eye on the first 48 hours after launch. A real person is always responsible for what reaches your customers.',
  },
  {
    q: 'Can my data stay on our own servers?',
    a: 'Yes. Where privacy rules are strict, everything can run on your own computers, so your data never leaves the building, and it works just the same as the online version.',
  },
];

const jsonLd = [
  service({
    name: 'AI Solutions & Workflows',
    description:
      'Managed AI help for small and medium businesses: replying to enquiries, following up, booking appointments, and keeping daily work moving, with a real person checking everything and the option to keep your data on your own computers.',
    path: '/services/ai-workflows',
  }),
  faqPage(faqs),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'AI Solutions & Workflows', path: '/services/ai-workflows' },
  ]),
];
---

<BaseLayout
  title="AI Solutions & Workflows for Small and Medium Businesses"
  description="Always-on AI help for small and medium businesses: instant replies to enquiries, follow-ups, booking, and everyday tasks, with a real person checking the work before it goes live."
  path="/services/ai-workflows"
  keywords="AI workflow automation, business process automation, enquiry response automation, appointment scheduling AI, on-premises AI, SMB automation"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <HeroMedia images={['/images/heroes/hero-aiworkflows.jpg']} sideText>
    <div class="max-w-xl text-left">
      <p class="eyebrow text-xl text-terracotta-300 md:text-2xl">AI Solutions & Workflows</p>
      <h1 class="mt-5 font-serif text-4xl font-extrabold leading-[1.1] md:text-5xl">
        The help that <span class="accent-em text-white">never</span> sleeps
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white">
        We swap slow, manual, mistake-prone tasks for always-on AI that replies to enquiries,
        follows up, books appointments, and keeps things moving for you, with a real person
        checking the work before it touches your business.
      </p>
      <div class="mt-9 flex flex-wrap justify-start gap-4">
        <Button href={site.booking} external>Get started →</Button>
        <Button href={site.contact} variant="dark">Talk to the team</Button>
      </div>
    </div>
  </HeroMedia>

  <HitlSteps heading="How we put AI to work, safely" />

  <!-- CAPABILITIES -->
  <section class="section bg-warm">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl md:text-4xl">What we take off your plate</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          It's not about any single tool. It's the right mix, set up around the way you and your
          team actually work.
        </p>
      </div>
      <div class="mt-14 grid items-stretch gap-8 lg:grid-cols-12">
        <div class="lg:col-span-5 xl:col-span-4">
          <img
            src="/images/content/ai-workflows-team.jpg"
            alt="A team building and reviewing automated workflows together"
            width="1280"
            height="854"
            loading="lazy"
            decoding="async"
            class="h-64 w-full rounded-2xl border border-navy/10 object-cover shadow-lg shadow-navy/5 sm:h-80 lg:h-full"
          />
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3 xl:col-span-8">
          {
            capabilities.map((c) => (
              <div class="card-lift flex flex-col p-6">
                <h3 class="text-lg text-navy">{c.h}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{c.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section bg-white">
    <div class="container-max">
      <h2 class="mx-auto max-w-2xl text-center text-3xl md:text-4xl">Doing it by hand vs. letting us handle it</h2>
      <div class="mt-12">
        <ComparisonTable
          columns={['What you get', 'By hand / DIY tools', 'Mile High AI Labs']}
          rows={[
            { label: 'Time to first reply', values: ['Hours to days', 'Seconds'] },
            { label: 'After-hours cover', values: [false, true] },
            { label: 'A real person checks the work', values: [false, true] },
            { label: 'Works across all your tools', values: ['Patchy', true] },
            { label: 'Can keep data on your own computers', values: [false, true] },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- DAY 30 OUTCOMES -->
  <section class="relative isolate overflow-hidden bg-navy py-20 text-white lg:py-28">
    <div class="pointer-events-none absolute -right-28 -top-28 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.22),transparent)]"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-28 h-80 w-80 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.16),transparent)]"></div>
    <div class="container-max relative">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-serif text-3xl font-bold text-terracotta-300 md:text-4xl">The outcomes we deliver</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          What changes once the everyday tasks run themselves.
        </p>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          metrics.map((m) => (
            <div class="rounded-2xl bg-white p-7 text-center shadow-lg shadow-black/10">
              <p class="font-serif text-4xl font-bold text-navy"><CountUp value={m.value} /></p>
              <p class="mt-2 text-sm text-ink-soft">{m.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <!-- CLOSING TESTIMONIAL + CTA -->
  <section class="section bg-warm pt-0">
    <div class="container-max">
      <div class="mx-auto max-w-3xl rounded-3xl border border-navy/10 bg-white bg-[radial-gradient(ellipse_55%_55%_at_50%_50%,rgba(124,92,255,0.13),transparent_72%)] px-8 py-12 text-center text-navy shadow-lg shadow-navy/5 md:px-12 md:py-14">
        <p class="accent-em mx-auto max-w-2xl text-3xl leading-snug text-navy md:text-4xl">
          “We were drowning in follow-up. Now every enquiry gets answered in under a minute, and
          I only get pinged when something actually needs me.”
        </p>
        <p class="mt-5 text-sm font-medium text-navy/60">Operations director, home services company</p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <Button href={site.booking} external size="sm">Book a Free Call</Button>
          <Button href={site.contact} variant="secondary" size="sm">Talk to our team</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
