---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import HITLBadge from '../components/HITLBadge.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { site, services, propProducts, lifecycle } from '../data/site';
import { organization, breadcrumb } from '../lib/jsonld';

const stats = [
  { value: '42k', label: 'Automation workflows deployed' },
  { value: '1.2M+', label: 'Leads processed' },
  { value: '24/7', label: 'Operations running' },
];

const jsonLd = [organization(), breadcrumb([{ name: 'Home', path: '/' }])];
---

<BaseLayout
  title="High-Authority AI for High-Performance Operations"
  description="Mile High AI Labs builds, runs, and manages AI systems for small and medium businesses — lead generation, marketing, and automation, with a human reviewing every output before it goes live."
  path="/"
  keywords="AI for small business, managed AI services, business automation, lead generation AI, human-in-the-loop AI, Denver AI company"
  jsonLd={jsonLd}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="container-max grid items-center gap-14 pb-20 pt-32 md:pt-40 lg:grid-cols-2 lg:pb-28">
      <div>
        <p class="eyebrow text-terracotta">Tailored intelligence for ambitious SMBs</p>
        <h1 class="mt-5 font-serif text-5xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">
          High-Authority AI for<br />
          <span class="accent-italic text-terracotta">High-Performance</span> Operations
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
          We deploy high-stakes automation for small and medium businesses — with human
          oversight built into the core architecture. You don't build it, configure it, or
          babysit it. You get the result.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <Button href={site.booking} external>Book a Free Audit →</Button>
          <Button href="#lifecycle" variant="dark">See how it works</Button>
        </div>
      </div>

      <!-- Carousel of what we build -->
      <HeroCarousel />
    </div>
  </section>

  <!-- ============ STAT BAR ============ -->
  <section class="border-b border-navy/10 bg-warm" aria-label="Key results">
    <div class="container-max grid grid-cols-1 gap-8 py-12 text-center sm:grid-cols-3">
      {
        stats.map((s) => (
          <div>
            <p class="font-serif text-4xl font-bold text-navy md:text-5xl">{s.value}</p>
            <p class="mt-1 text-sm text-ink-soft">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ MANAGED EXCELLENCE ============ -->
  <section class="section bg-warm">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl md:text-4xl">Our managed excellence</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          We don't just sell tools. We implement them, run them, and manage them — so
          complexity leaves your operation and results stay.
        </p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          services.map((s) => (
            <a href={s.href} class="card-lift group flex flex-col p-8">
              <HITLBadge class="self-start" />
              <h3 class="mt-5 font-serif text-2xl text-navy">{s.label}</h3>
              <p class="mt-3 flex-1 text-base leading-relaxed text-ink-soft">{s.blurb}</p>
              <span class="mt-6 text-sm font-semibold text-navy transition-colors group-hover:text-terracotta-600">
                Learn more →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROPSPECTRUM SUITE ============ -->
  <section class="section bg-warm pt-0">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow text-terracotta">For real estate</p>
        <h2 class="mt-3 text-3xl md:text-4xl">The PropSpectrum Suite</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Our real estate wing — the same delivery method and human review, packaged for
          agents and teams.
        </p>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          propProducts.map((p) => (
            <a href={p.href} class="card-lift group flex flex-col p-7">
              <span
                class:list={[
                  'inline-block h-1.5 w-10 rounded-full',
                  p.color === 'forest' && 'bg-forest',
                  p.color === 'amber' && 'bg-amber',
                  p.color === 'terracotta' && 'bg-terracotta',
                ]}
              />
              <h3 class="mt-5 font-serif text-xl text-navy">{p.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{p.oneLine}</p>
              <span class="mt-5 text-xs font-semibold uppercase tracking-wide text-navy/50 group-hover:text-terracotta-600">
                Explore {p.name} →
              </span>
            </a>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <Button href="/propspectrum" variant="secondary">Explore the PropSpectrum suite →</Button>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT (folded into home) ============ -->
  <section id="about" class="section bg-white">
    <div class="container-max grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-terracotta">Who we are</p>
        <h2 class="mt-3 text-3xl md:text-4xl">A studio for AI — not a tool you rent</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          Mile High AI Labs is a Denver team with genuine technical expertise that builds,
          runs, and manages AI systems for small and medium businesses. We're not a SaaS
          product you sign up for and figure out alone, and we're not a one-and-done
          consulting deck.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Think of a recording studio. You don't care which microphones or software it uses —
          you care that every time, a professional result comes out. Our delivery process is
          the studio. Our human review is the engineer who checks the mix before it leaves the
          building. No two clients get the same stack; every client gets the same quality.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            { h: 'Expert', p: 'Genuine AI engineering — not prompt-and-pray.' },
            { h: 'Canonical', p: 'A repeatable six-step process behind every build.' },
            { h: 'Accountable', p: 'A human signs off before anything reaches your customers.' },
            { h: 'Denver-built', p: 'Grounded in a real place and a real business community.' },
          ].map((item) => (
            <div class="card-lift p-6">
              <h3 class="font-serif text-xl text-navy">{item.h}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HITL ANCHOR (navy) ============ -->
  <section class="bg-navy py-20 text-white lg:py-28">
    <div class="container-max grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <h2 class="font-serif text-4xl font-bold leading-tight md:text-5xl">
          AI isn't the final word.<br /><span class="accent-italic text-terracotta">You are.</span>
        </h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
          Every AI tool on the market runs on autopilot. It drafts an email and sends it. It
          builds an automation and deploys it. No one checks it — until it fails in front of
          your customer. We put a person between the AI and the output, every single time.
          That's not a feature. It's the entire point.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <TestimonialCard
          variant="dark"
          quote="We'd been burned by an automation that emailed the wrong quote to a client. What sold me was that a person signs off before anything goes out. Six months in, that's still true."
          name="Dana Whitfield"
          role="Owner, HVAC & plumbing company"
        />
        <TestimonialCard
          variant="dark"
          quote="I don't want to learn another dashboard. They set it up, they watch it, and they call me if something looks off. That's the whole reason it stuck for us."
          name="Marcus Reyes"
          role="Managing partner, regional law firm"
        />
      </div>
    </div>
  </section>

  <!-- ============ DEPLOYMENT LIFECYCLE ============ -->
  <section id="lifecycle" class="section bg-warm">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl md:text-4xl">Our Deployment Lifecycle</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          A systematic six-step process for intelligent, managed automation — the same one
          behind every engagement.
        </p>
      </div>
      <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          lifecycle.map((s, i) => (
            <li
              class:list={[
                'rounded-2xl border p-7',
                s.hitl ? 'border-terracotta bg-terracotta/10' : 'border-navy/10 bg-white',
              ]}
            >
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    'flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold',
                    s.hitl ? 'bg-terracotta text-navy' : 'bg-navy text-white',
                  ]}
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="font-serif text-xl text-navy">{s.step}</h3>
                {s.hitl && (
                  <span class="ml-auto rounded-full bg-terracotta px-2.5 py-0.5 text-xs font-semibold text-navy">
                    HITL
                  </span>
                )}
              </div>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ VOICE OF THE PARTNERS ============ -->
  <section class="section bg-white">
    <div class="container-max">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl md:text-4xl">Voice of the partners</h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
        <TestimonialCard
          quote="Our front desk used to lose an hour a day chasing confirmations. That's gone — and we didn't have to rip out a single tool the staff actually likes using."
          name="Priya Nair"
          role="Operations lead, dental group · Denver, CO"
        />
        <TestimonialCard
          quote="What I appreciate is the honesty. They told me one of my ideas wasn't worth automating yet. You don't hear that from agencies trying to bill you for everything."
          name="Tom Caldwell"
          role="Founder, B2B logistics startup"
        />
      </div>
    </div>
  </section>

  <!-- ============ APPS CONSULTANTS ============ -->
  <section class="bg-forest py-16 text-white">
    <div class="container-max flex flex-col items-center gap-10 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col items-center gap-7 sm:flex-row sm:items-center md:flex-1">
        <a
          href="https://appsconsultants.com"
          target="_blank"
          rel="noopener"
          class="shrink-0 rounded-xl bg-white p-5 shadow-lg shadow-black/20 transition-transform hover:-translate-y-0.5"
          aria-label="Apps Consultants"
        >
          <img
            src="/images/logo-apps-consultants.png"
            alt="Apps Consultants"
            width="318"
            height="159"
            class="h-16 w-auto"
          />
        </a>
        <div class="max-w-xl text-center sm:text-left">
          <p class="eyebrow text-amber">Strategic partner · Apps Consultants</p>
          <p class="mt-3 text-lg leading-relaxed text-white/85">
            For enterprise-scale needs, we refer to our sister company Apps Consultants —
            trusted by Fortune 1000 companies since 2005. Between us, the ecosystem covers
            everything from a five-person shop to a Fortune 1000 rollout.
          </p>
        </div>
      </div>
      <Button href="https://appsconsultants.com" external variant="dark">Meet Apps Consultants</Button>
    </div>
  </section>

  <!-- ============ CLOSING CTA ============ -->
  <section class="section bg-warm">
    <div class="container-max">
      <div class="rounded-3xl bg-navy px-8 py-16 text-center text-white md:px-16 md:py-20">
        <h2 class="accent-italic mx-auto max-w-2xl text-4xl text-white md:text-5xl">
          Ready to scale your intelligence?
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/75">
          Join the business owners who traded operational chaos for intelligent, managed
          automation — with a human watching the output.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <Button href={site.booking} external>Book a Free Audit</Button>
          <Button href={`mailto:${site.email}`} variant="dark">Contact strategy team</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
